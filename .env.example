# Local chat demo. Copy to .env; never commit credentials
AGENTIC_RUNTIME_PROFILE=development
AGENTIC_LLM_PROVIDER=echo
AGENTIC_JUDGMENT_PROVIDER=none
AGENTIC_WEB_HOST=127.0.0.1
AGENTIC_WEB_PORT=3400
AGENTIC_WEB_UNSAFE_LOCAL_IDENTITY=true

# Real model: change AGENTIC_LLM_PROVIDER to deepseek and set the key below
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_THINKING=true

# Optional durable storage; the basic demo uses memory
# DATABASE_URL=
# REDIS_URL=
# AGENTIC_DATA_ENCRYPTION_KEY=
# AGENTIC_DATA_ENCRYPTION_KEY_ID=

# Full supported settings: scripts/env-registry.mjs
