# Runtime/library base only. It is not an isolation boundary for generated code.
# Contains no MCP SDK, HTTP API, product code, credentials or S3 adapter.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY mcp-servers/agent-execution/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt
COPY mcp-servers/agent-execution/runtime-js/package.json \
     mcp-servers/agent-execution/runtime-js/package-lock.json /usr/local/lib/sandbox-node-modules/
RUN npm ci --prefix /usr/local/lib/sandbox-node-modules --omit=dev --ignore-scripts --no-audit --no-fund \
    && rm -rf /root/.npm
RUN ln -s /usr/local/lib/sandbox-node-modules/node_modules /node_modules
